# Copy this file to .env and fill in your values:
#   cp .env.example .env

# GitHub settings (leave GITHUB_USER empty to auto-detect from `gh auth status`)
GITHUB_USER=
REPO_NAME=argocd-ml-gitops

# Docker Hub settings (create a Read/Write/Delete Personal Access Token at https://app.docker.com/settings/personal-access-tokens)
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
IMAGE_NAME=flask-ml-app

# Local kind cluster name
CLUSTER_NAME=argocd-three-node
